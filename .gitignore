
# Terraform working directory
.terraform/

# Terraform state files (may contain passwords and secrets)
*.tfstate
*.tfstate.*

# Terraform variable files (may contain credentials)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment variables and secrets
.env
.env.*
!.env.example

# Operating system files
.DS_Store
Thumbs.db

*.tfplan
